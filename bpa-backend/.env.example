# ============================================================
# LCC BPA Backend Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lcc_bpa
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRY=86400

# PayMongo
PAYMONGO_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYMONGO_PUBLIC=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYMONGO_WEBHOOK=whsec_xxxxxxxxxxxxxxxxxxxx

# App
APP_URL=http://localhost/lccsystem/bpa-backend
PERMIT_FEE=500.00
CORS_ORIGIN=http://localhost:5173

# Upload directory (absolute path)
UPLOAD_DIR=/var/www/html/bpa-backend/uploads/
