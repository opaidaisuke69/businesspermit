# When using Vite dev server (npm run dev), set to /api — the proxy handles it
VITE_API_URL=/api

# VITE_BACKEND_URL controls where the Vite proxy forwards /api requests
# XAMPP (default):   http://localhost/lccsystem/bpa-backend
# PHP built-in server: http://localhost:8000
# Production:        https://api.lcc-bpa.gov.ph
VITE_BACKEND_URL=http://localhost/lccsystem/bpa-backend
